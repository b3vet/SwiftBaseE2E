# SwiftBase Configuration
SWIFTBASE_URL=http://localhost:8090
SWIFTBASE_API_VERSION=1.0

# Test Admin Credentials
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=admin123

# Test User Credentials (generated dynamically)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!

# Test Configuration
TEST_TIMEOUT=30000
TEST_RETRY_COUNT=3
TEST_PARALLEL=true

# Debug Mode
DEBUG_MODE=false
LOG_LEVEL=info

# Storage Configuration
STORAGE_TEST_DIR=./test-data/storage
MAX_FILE_SIZE=104857600

# Database Configuration (if needed for direct DB access)
DB_PATH=./data/swiftbase.db
