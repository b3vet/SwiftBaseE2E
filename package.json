{
  "name": "swiftbase-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-End test suite for SwiftBase API",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:auth": "vitest run src/tests/auth",
    "test:collections": "vitest run src/tests/collections",
    "test:query": "vitest run src/tests/query",
    "test:storage": "vitest run src/tests/storage",
    "test:integration": "vitest run src/tests/integration",
    "test:api": "vitest run src/tests/api",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "swiftbase",
    "e2e",
    "testing",
    "vitest",
    "api-testing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/ui": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "dotenv": "^16.3.1",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "form-data": "^4.0.0",
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
